SECRET_KEY=genera-una-con-get_random_secret_key
DEBUG=True
DB_NAME=registro_postquirurgico_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_local
DB_HOST=localhost
DB_PORT=5432

# Hosts permitidos (separados por coma). NUNCA usar '*'.
# Dev con ngrok: usa el comodín de subdominio para no editar en cada reinicio:
#   ALLOWED_HOSTS=.ngrok-free.dev
# Prod: el dominio real, ej: ALLOWED_HOSTS=monitoreo.tudominio.com
ALLOWED_HOSTS=

# Twilio (Sprint 3+). Secretos: solo aquí, nunca en el código.
# IMPORTANTE: usar el Auth Token PRIMARIO (Twilio Console -> Account Dashboard),
# NO el de Test Credentials. El Sandbox de WhatsApp firma sus webhooks con el
# Auth Token primario; usar el de Test provoca un 403 (firma inválida).
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# Opcional, solo pruebas locales sin firma real:
# TWILIO_VALIDATE_SIGNATURE=False

# SMTP real (Sprint 5, Bloque 5) — solo aplica con settings_production.
# En desarrollo (settings_local.py) el email se imprime en consola, no se envía.
# Usar una cuenta de Gmail dedicada al proyecto (no personal), con verificación
# en 2 pasos activada y una "contraseña de aplicación" generada en
# myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones.
# NUNCA la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=cuenta-del-proyecto@gmail.com
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
DEFAULT_FROM_EMAIL=Sistema Monitoreo Posquirúrgico <cuenta-del-proyecto@gmail.com>