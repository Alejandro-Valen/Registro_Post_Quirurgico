# Plantilla de desarrollo. No copiarla completa a Railway: configurar allí cada
# variable con valores propios y mantener DEBUG=False/settings_production.
SECRET_KEY=genera-una-con-get_random_secret_key
DEBUG=True
DB_NAME=registro_postquirurgico_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_local
DB_HOST=localhost
DB_PORT=5432

# Hosts permitidos (separados por coma). NUNCA usar '*'.
# Dev con ngrok: usa el comodín de subdominio para no editar en cada reinicio:
#   ALLOWED_HOSTS=.ngrok-free.dev
# Prod: el dominio real, ej: ALLOWED_HOSTS=monitoreo.tudominio.com
ALLOWED_HOSTS=
# Solo producción, con esquema HTTPS y separado por comas si hay varios.
CSRF_TRUSTED_ORIGINS=

# Desarrollo usa admin/. En producción elegir un slug privado terminado en /.
ADMIN_URL=admin/

# Activar solo si TODO el tráfico público llega por el edge de Railway.
# Permite usar X-Real-IP para el rate limit del formulario de contacto.
TRUST_RAILWAY_PROXY=False

# Producción multi-worker. En Railway usar la referencia del servicio Redis.
REDIS_URL=redis://localhost:6379/1

# Bootstrap de cuentas. En producción, retirar USERNAME/PASSWORD después del
# primer arranque exitoso para que no se restablezcan en cada despliegue.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
DJANGO_MEDICO_USERNAME=
DJANGO_MEDICO_PASSWORD=
DJANGO_MEDICO_EMAIL=

# Usuario staff que recibirá los mensajes del formulario público.
# Debe coincidir con DJANGO_MEDICO_USERNAME si existe un solo médico.
MEDICO_CONTACTO_USERNAME=

# Twilio (Sprint 3+). Secretos: solo aquí, nunca en el código.
# IMPORTANTE: usar el Auth Token PRIMARIO (Twilio Console -> Account Dashboard),
# NO el de Test Credentials. El Sandbox de WhatsApp firma sus webhooks con el
# Auth Token primario; usar el de Test provoca un 403 (firma inválida).
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# Opcional, solo pruebas locales sin firma real:
# TWILIO_VALIDATE_SIGNATURE=False

# SMTP real (Sprint 5, Bloque 5) — solo aplica con settings_production.
# En desarrollo (settings_local.py) el email se imprime en consola, no se envía.
# Usar una cuenta de Gmail dedicada al proyecto (no personal), con verificación
# en 2 pasos activada y una "contraseña de aplicación" generada en
# myaccount.google.com -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones.
# NUNCA la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=cuenta-del-proyecto@gmail.com
EMAIL_HOST_PASSWORD=contraseña-de-aplicacion-de-16-caracteres
DEFAULT_FROM_EMAIL=Sistema Monitoreo Posquirúrgico <cuenta-del-proyecto@gmail.com>
EMAIL_TIMEOUT=10
# URL HTTPS completa del acceso médico. El correo de alerta enlaza aquí sin
# incluir cédula, teléfono, síntomas ni otros datos clínicos.
PANEL_MEDICO_URL=https://monitoreo.tudominio.com/ruta-admin-segura/

# Alternativa HTTPS recomendada en Railway cuando SMTP saliente está bloqueado.
# Con onboarding@resend.dev solo se puede enviar al correo de la cuenta Resend;
# para otros destinatarios se requiere un dominio verificado.
# Desarrollo local puede conservar django; en Railway usar resend.
EMAIL_DELIVERY_PROVIDER=django
RESEND_API_KEY=
RESEND_FROM_EMAIL=Seguimiento posquirúrgico <onboarding@resend.dev>

# Interruptor operativo temporal para desbloquear django-axes al arrancar.
# Mantener 0 o ausente; después de usar 1, retirarlo inmediatamente.
RESET_AXES=0
